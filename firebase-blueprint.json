{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "merchant"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A payment or settlement transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "merchant": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "type": { "type": "string", "enum": ["payment", "deposit", "withdrawal"] },
        "status": { "type": "string", "enum": ["completed", "pending", "failed"] },
        "date": { "type": "string" },
        "timestamp": { "type": "string" },
        "notes": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "merchant", "amount", "currency", "type", "status", "date", "timestamp", "userId", "createdAt"]
    },
    "DeveloperSettings": {
      "title": "Developer Settings",
      "description": "API keys and webhook configurations for a merchant",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "apiKey": { "type": "string" },
        "webhookSecret": { "type": "string" },
        "webhookUrl": { "type": "string" },
        "stripePublishableKey": { "type": "string" },
        "stripeSecretKey": { "type": "string" },
        "bitcartUrl": { "type": "string" },
        "bitcartApiKey": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "apiKey", "webhookSecret", "updatedAt"]
    },
    "Store": {
      "title": "Store",
      "description": "Merchant store configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "bitcartUrl": { "type": "string" },
        "bitcartApiKey": { "type": "string" }
      },
      "required": ["id", "userId", "name"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "paid", "expired"] },
        "bitcartInvoiceId": { "type": "string" },
        "nfcDeviceId": { "type": "string" }
      },
      "required": ["id", "storeId", "amount", "currency", "status"]
    },
    "NfcDevice": {
      "title": "NfcDevice",
      "description": "NFC device registration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "deviceId": { "type": "string" },
        "storeId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["id", "deviceId", "storeId", "status"]
    },
    "ShariaCompliance": {
      "title": "Sharia Compliance",
      "description": "Sharia compliance checklist for a merchant",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "number" },
              "en": { "type": "string" },
              "ar": { "type": "string" },
              "compliant": { "type": "boolean" }
            }
          }
        },
        "reviewDate": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "checklist", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Transactions belonging to merchants"
    },
    "developerSettings/{userId}": {
      "schema": { "$ref": "#/entities/DeveloperSettings" },
      "description": "Developer settings for merchants"
    },
    "stores/{storeId}": {
      "schema": { "$ref": "#/entities/Store" },
      "description": "Merchant stores"
    },
    "orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders"
    },
    "nfc_devices/{deviceId}": {
      "schema": { "$ref": "#/entities/NfcDevice" },
      "description": "Registered NFC devices"
    },
    "shariaCompliance/{userId}": {
      "schema": { "$ref": "#/entities/ShariaCompliance" },
      "description": "Sharia compliance status for merchants"
    }
  }
}
